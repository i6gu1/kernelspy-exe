<Window x:Class="KernelSpyScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KernelSpy Scanner" Height="820" Width="1280"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" Icon="icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <TextBlock Text="KernelSpy" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="8,12,8,0" />
                <TextBlock Text="Scanner" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,8,16" />

                <Button x:Name="BtnHome" Content="Home" Click="Nav_Click" Tag="Home" Margin="0,4" Style="{StaticResource NavButton}" />
                <Button x:Name="BtnScan" Content="Scan" Click="Nav_Click" Tag="Scan" Margin="0,4" Style="{StaticResource NavButton}" />
                <Button x:Name="BtnResults" Content="Results" Click="Nav_Click" Tag="Results" Margin="0,4" Style="{StaticResource NavButton}" />
                <Button x:Name="BtnReports" Content="Reports" Click="Nav_Click" Tag="Reports" Margin="0,4" Style="{StaticResource NavButton}" />
                <Button x:Name="BtnSettings" Content="Settings" Click="Nav_Click" Tag="Settings" Margin="0,4" Style="{StaticResource NavButton}" />

                <TextBlock Text="v1.4.4" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="8,24,8,0" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24" Background="{StaticResource BgDarkBrush}">
            <!-- Home -->
            <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource BgDarkBrush}">
                <StackPanel>
                    <TextBlock Text="Welcome to KernelSpy Scanner" FontSize="26" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="A high-performance, asynchronous security scanner for source code. Built with C# and WPF." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Padding="16" Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="Features" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="• Built-in regex security rules (SQLi, XSS, Command Injection, Secrets, ...)" />
                            <TextBlock Text="• Integrated ESLint code analysis" />
                            <TextBlock Text="• Integrated Semgrep SAST" />
                            <TextBlock Text="• Export reports to HTML and JSON" />
                            <TextBlock Text="• Async, responsive, crash-resistant" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Scan -->
            <Grid x:Name="PageScan" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Scan" FontSize="26" FontWeight="Bold" Margin="0,0,0,12" />
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderTextBox" Grid.Column="0" />
                    <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Margin="8,0,0,0" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="StartButton" Content="Start Scan" Click="StartScan_Click" Width="120" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Width="100" Margin="8,0,0,0" IsEnabled="False" />
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <ProgressBar x:Name="ScanProgress" Height="18" Margin="0,0,0,8" />
                    <TextBlock x:Name="StatusText" Text="Idle" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Results -->
            <Grid x:Name="PageResults" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Results" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ResultsCount" Text="0 findings" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" RowHeight="30" HeadersVisibility="Column"
                          CanUserResizeColumns="False" CanUserReorderColumns="False">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="HIGH">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="MEDIUM">
                                    <Setter Property="Foreground" Value="{StaticResource MediumBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                        <DataGridTextColumn Header="File" Binding="{Binding File}" Width="260" />
                        <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="60" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="200" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130" />
                        <DataGridTextColumn Header="Analyzer" Binding="{Binding Analyzer}" Width="110" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Reports -->
            <Grid x:Name="PageReports" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Reports" FontSize="26" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="Export the latest scan results to a clean, structured format." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Export HTML" Click="ExportHtml_Click" Width="140" Margin="0,0,8,0" />
                        <Button Content="Export JSON" Click="ExportJson_Click" Width="140" />
                    </StackPanel>
                    <TextBlock x:Name="ReportStatus" Margin="0,16,0,0" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Grid>

            <!-- Settings -->
            <Grid x:Name="PageSettings" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="External tools are bundled under the application's tools folder. No separate installation is required." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="ESLint: bundled, including its Node.js runtime" Margin="0,0,0,4" />
                            <TextBlock Text="Semgrep: bundled native engine, including rules" Margin="0,0,0,4" />
                            <TextBlock Text="Use the Scan page to run analysis." Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
