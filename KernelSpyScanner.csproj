<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>KernelSpy Scanner</AssemblyName>
    <RootNamespace>KernelSpyScanner</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.4.4</Version>
    <Company>The L house</Company>
    <Product>KernelSpy Scanner</Product>
    <Description>KernelSpy security scanner - C# WPF edition</Description>

    <!-- The published application carries the .NET runtime so it can start on
         machines that have no .NET installation at all. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Do not let the SDK recursively glob the large external tools folder. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="Themes\DarkTheme.xaml" />
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="Models\**\*.cs" />
    <Compile Include="Engine\**\*.cs" />
    <Compile Include="Integrations\**\*.cs" />
    <Compile Include="Reporting\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Rules\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy every bundled tool (ESLint + its Node.js runtime, Semgrep runtime,
       rules, helper scripts) into the publish output. A custom target is used
       instead of Content globs so nothing is lost to SDK default excludes
       (notably node_modules). -->
  <Target Name="CopyBundledToolsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_BundledToolFiles Include="$(MSBuildProjectDirectory)\tools\**\*" />
    </ItemGroup>

    <Error Condition="'@(_BundledToolFiles)' == ''"
           Text="The bundled tools folder is empty. Expected tools\ under $(MSBuildProjectDirectory)." />

    <Copy SourceFiles="@(_BundledToolFiles)"
          DestinationFiles="@(_BundledToolFiles->'$(PublishDir)tools\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Message Importance="high"
             Text="Bundled @(_BundledToolFiles->Count()) tool files into $(PublishDir)tools." />
  </Target>

</Project>
